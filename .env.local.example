# Kopieer dit bestand naar .env.local en vul je eigen waarden in.
# .env.local wordt nooit meegecommit naar Git (staat in .gitignore).

# Te vinden op sanity.io/manage → jouw project → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Meestal "production", tenzij je een ander dataset hebt aangemaakt
NEXT_PUBLIC_SANITY_DATASET=production

# API-versie — een vaste datum, hoeft niet gewijzigd te worden
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Alleen nodig als je de revalidate-webhook instelt (zie README,
# "Stap 6: automatische updates instellen"). Zelfverzonnen geheime
# waarde, ook ingevuld bij het aanmaken van de webhook in Sanity.
SANITY_REVALIDATE_SECRET=

# Alleen nodig om het seed-script te draaien (npm run seed:sanity).
# Maak aan via sanity.io/manage → jouw project → API → Tokens →
# "Add API token" → permissie "Editor". Nooit delen of committen —
# dit token kan schrijven naar je Sanity-project.
SANITY_API_WRITE_TOKEN=
